{
  "name": "wj-quant-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env server.js",
    "start": "node server.js",
    "start:render": "prisma migrate deploy && node server.js",
    "test": "node --test tests/money.test.js tests/health.test.js tests/db-connection.test.js",
    "test:integration": "node --test tests/integration.test.js tests/migration-upgrade.test.js",
    "build": "prisma validate && prisma generate && node --check app.js && node --check server.js",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.24.0"
  }
}
