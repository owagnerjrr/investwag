DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wjquant?schema=public
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Leave 0 unless your host has exactly one trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
NODE_ENV=development
QUANT_ENABLED=0

# Automatic fictitious pilot (off by default)
PILOT_ENABLED=0
# Private >=32-char secret, same value on scheduler. Never VITE_
PILOT_SCHEDULE_SECRET=
# Optional free Demo key; keyless scheduled polling is disabled
COINGECKO_DEMO_KEY=
# Optional conservative owner policy JSON. Defaults documented in QUANT-3.md.
PILOT_POLICY_JSON=
