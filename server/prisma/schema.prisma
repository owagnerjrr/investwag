generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) email String @unique passwordHash String createdAt DateTime @default(now()) portfolio Portfolio? }
model Portfolio { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId],references:[id]) cashCents BigInt @default(0) contributedCents BigInt @default(0) withdrawnCents BigInt @default(0) paused Boolean @default(true) movements CashMovement[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model CashMovement { id String @id @default(cuid()) portfolioId String portfolio Portfolio @relation(fields:[portfolioId],references:[id]) type MovementType amountCents BigInt createdAt DateTime @default(now()) @@index([portfolioId,createdAt]) }
enum MovementType { DEPOSIT WITHDRAW }
