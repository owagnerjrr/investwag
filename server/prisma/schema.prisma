generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  portfolio Portfolio?
  sessions Session[]
  quantAssets QuantAsset[]
  quantStrategies QuantStrategy[]
  quantRuns QuantRun[]
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@index([userId])
}
model Portfolio {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashCents BigInt @default(0)
  contributedCents BigInt @default(0)
  withdrawnCents BigInt @default(0)
  paused Boolean @default(true)
  movements CashMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CashMovement {
  id String @id @default(cuid())
  portfolioId String
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  type MovementType
  amountCents BigInt
  idempotencyKey String
  createdAt DateTime @default(now())
  @@unique([portfolioId, idempotencyKey])
  @@index([portfolioId, createdAt])
}
enum MovementType {
  DEPOSIT
  WITHDRAW
}

model QuantAsset {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol String
  lastFetch DateTime?
  lastError String?
  bars QuantBar[]
  analyses QuantAnalysis[]
  createdAt DateTime @default(now())
  @@unique([userId, symbol])
}
model QuantBar {
  id String @id @default(cuid())
  assetId String
  asset QuantAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  priceMicros BigInt
  source String
  sourceDate DateTime? @db.Date
  provenance Json?
  fetchedAt DateTime @default(now())
  @@unique([assetId, date])
}
model QuantAnalysis {
  id String @id @default(cuid())
  assetId String
  asset QuantAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  result Json
  createdAt DateTime @default(now())
  @@index([assetId, createdAt])
}
model QuantStrategy {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  version String @default("sma-cross-v1")
  config Json
  idempotencyKey String
  createdAt DateTime @default(now())
  @@index([userId])
  @@unique([userId, idempotencyKey])
}
model QuantRun {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  status String
  assetId String
  strategyId String
  config Json
  state Json
  datasetHash String
  idempotencyKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events QuantEvent[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}
model QuantEvent {
  id String @id @default(cuid())
  runId String
  run QuantRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  key String
  result Json
  createdAt DateTime @default(now())
  @@unique([runId, key])
}
